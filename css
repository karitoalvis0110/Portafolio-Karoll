:root{
--bg:#080812;--card:#111827;--line:#2b2f47;--accent:#8b5cf6;--accent2:#a855f7;
--text:#fff;--muted:#b7bfd4;
}
*{margin:0;padding:0;box-sizing:border-box}
body{font-family:Manrope,sans-serif;background:radial-gradient(circle at top,#2b124b 0,#080812 35%,#080812 100%);color:var(--text)}
.layout{display:grid;grid-template-columns:260px 1fr;min-height:100vh}
aside{padding:30px 30px 30px 70px;background:#0b1020;border-right:1px solid #222;position:sticky;top:0;height:100vh}
 .logo{margin-left:30px;font:700 2rem "Space Grotesk";color:var(--accent)}
.menu a{display:block;margin:20px 0;padding:16px 18px 16px 36px;border-radius:12px;color:#d8d8e8;text-decoration:none}
.menu a:hover{background:linear-gradient(90deg,var(--accent),transparent)}
main{padding:30px}
.hero,.card{background:rgba(17,24,39,.88);border:1px solid var(--line);border-radius:24px;backdrop-filter:blur(10px)}
.hero{display:grid;grid-template-columns:1.2fr .8fr;gap:20px;padding:40px;margin-bottom:24px}
.hero h1{font:700 3.8rem "Space Grotesk";line-height:1.05}
.hero span{color:var(--accent)}
.hero p{margin:18px 0;color:var(--muted);line-height:1.8}
.btn{display:inline-block;background:linear-gradient(90deg,var(--accent),var(--accent2));padding:14px 28px;border-radius:50px;color:#fff;text-decoration:none}
.avatar{display:flex;align-items:center;justify-content:center;font-size:10rem}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.card{padding:24px;min-height:240px}
.card h3{margin-bottom:18px;font-family:"Space Grotesk"}
.skill{display:flex;justify-content:space-between;margin:10px 0}
.bar{height:8px;background:#23263b;border-radius:99px;overflow:hidden;margin:6px 0 14px}
.bar span{display:block;height:100%;width:95%;background:linear-gradient(90deg,var(--accent),#c084fc)}
.gallery{
display:grid;
grid-template-columns:repeat(auto-fit,minmax(320px,1fr));
gap:25px;
margin-top:20px;
}

.project{
position:relative;
overflow:hidden;
border-radius:18px;
cursor:pointer;
box-shadow:0 10px 25px rgba(0,0,0,.3);
}

.project img{
width:100%;
height:260px;
object-fit:cover;
display:block;
transition:.5s;
}

.project:hover img{
transform:scale(1.08);
}

.overlay{
position:absolute;
left:0;
right:0;
bottom:0;
padding:20px;
background:linear-gradient(transparent,rgba(0,0,0,.95));
color:#fff;
opacity:0;
transition:.4s;
}

.project:hover .overlay{
opacity:1;
}

.overlay h4{
margin-bottom:8px;
font-size:20px;
}

.overlay p{
font-size:15px;
color:#ddd;
}
@media(max-width:1000px){
.layout{grid-template-columns:1fr}
aside{position:relative;height:auto}
.hero{grid-template-columns:1fr}
.grid{grid-template-columns:1fr}
}

.social-floating{
position:fixed;left:18px;top:50%;transform:translateY(-50%);
display:flex;flex-direction:column;gap:14px;z-index:99999}
.social{
width:56px;height:56px;border-radius:50%;
display:flex;align-items:center;justify-content:center;
background:rgba(255,255,255,.08);
backdrop-filter:blur(12px);
border:1px solid rgba(255,255,255,.12);
color:#fff;text-decoration:none;font-size:13px;
box-shadow:0 0 20px rgba(139,92,246,.35);
transition:.3s;
animation:floating 3s ease-in-out infinite;
}
.social:hover{
transform:translateX(8px) scale(1.12);
background:linear-gradient(135deg,#7C3AED,#A855F7);
box-shadow:0 0 35px rgba(168,85,247,.8)}
.social:nth-child(2){animation-delay:.2s}
.social:nth-child(3){animation-delay:.4s}
.social:nth-child(4){animation-delay:.6s}
.social:nth-child(5){animation-delay:.8s}
.social:nth-child(6){animation-delay:1s}
.social:nth-child(7){animation-delay:1.2s}
@keyframes floating{
0%{transform:translateY(0)}
50%{transform:translateY(-8px)}
100%{transform:translateY(0)}
}


.whatsapp-floating{
position:fixed;
right:16px;
bottom:20px;
width:36px;
height:36px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
text-decoration:none;
font-size:13px;
color:#fff;
background:linear-gradient(135deg,#25D366,#128C7E);
box-shadow:0 0 30px rgba(37,211,102,.5);
z-index:99999;
transition:.3s;
animation:floatWhatsapp 2.8s ease-in-out infinite;
}
.whatsapp-floating:hover{
transform:scale(1.12);
box-shadow:0 0 45px rgba(37,211,102,.8);
}
@keyframes floatWhatsapp{
0%{transform:translateY(0)}
50%{transform:translateY(-8px)}
100%{transform:translateY(0)}
}


.bot-floating,.forum-floating{
position:fixed;
right:16px;
width:36px;
height:36px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
color:#fff;
text-decoration:none;
font-size:15px;
z-index:99999;
transition:.3s;
box-shadow:0 0 30px rgba(139,92,246,.45);
animation:floatExtra 3s ease-in-out infinite;
}
.bot-floating{bottom:150px;background:linear-gradient(135deg,#7C3AED,#A855F7);}
.forum-floating{bottom:85px;background:linear-gradient(135deg,#2563EB,#3B82F6);}
.bot-floating:hover,.forum-floating:hover{transform:scale(1.1);}
@keyframes floatExtra{
0%{transform:translateY(0)}
50%{transform:translateY(-8px)}
100%{transform:translateY(0)}
}


#loader{
position:fixed;inset:0;
background:#09090B;
display:flex;
flex-direction:column;
justify-content:center;
align-items:center;
z-index:999999;
}
@keyframes logoSpin{from{transform:rotateY(0deg);}to{transform:rotateY(360deg);}}
#loader h1{
font-family:'Space Grotesk',sans-serif;
color:#A855F7;
letter-spacing:3px;
margin-bottom:20px;transform-style:preserve-3d;
}
.loader-bar{
width:220px;
height:8px;
background:#222;
border-radius:99px;
overflow:hidden;
}
.loader-bar span{
display:block;
height:100%;
width:0;
background:linear-gradient(90deg,#7C3AED,#A855F7);
animation:loadbar 2s forwards;
}
@keyframes loadbar{to{width:100%;}}


.skill-item{margin:18px 0}
.skill-head{display:flex;justify-content:space-between;margin-bottom:6px;font-weight:600}
.progress{height:10px;background:#25273f;border-radius:999px;overflow:hidden}
.fill{height:100%;width:0;background:linear-gradient(90deg,#7C3AED,#A855F7);border-radius:999px}


.services-grid{display:grid;gap:12px}
.service-box{position:relative;padding:14px;border-radius:14px;background:#1a2033;cursor:pointer;transition:.35s;border:1px solid rgba(255,255,255,.08);overflow:hidden}
.service-box:hover{background:linear-gradient(135deg,#7C3AED,#A855F7);transform:translateY(-4px);box-shadow:0 12px 30px rgba(124,58,237,.35)}
.service-box h4{margin:0;font-size:15px}
.service-info{max-height:0;opacity:0;transition:max-height .35s ease,opacity .35s ease;margin-top:0}
.service-box:hover .service-info{max-height:140px;opacity:1;margin-top:10px}
.service-info p{font-size:13px;line-height:1.5;color:#fff}


.service-box{position:relative;overflow:visible;z-index:100}
.service-popup{
position:absolute;
left:105%;
top:50%;
transform:translateY(-50%) scale(.9);
width:320px;
background:rgba(17,24,39,.96);
border:1px solid rgba(168,85,247,.45);
border-radius:18px;
padding:18px;
box-shadow:0 20px 40px rgba(0,0,0,.45);
opacity:0;
visibility:hidden;
transition:.35s;
backdrop-filter:blur(14px);
z-index:999999;
}
.service-popup h5{
margin:0 0 10px;
font-size:18px;
color:#c084fc;
}
.service-popup ul{
padding-left:18px;
margin:0;
}
.service-popup li{
margin:8px 0;
font-size:13px;
color:#d8d8e8;
}
.service-box:hover{
background:linear-gradient(135deg,#7C3AED,#A855F7);
}
.service-box:hover .service-popup{
opacity:1;
visibility:visible;
transform:translateY(-50%) scale(1);
}


.theme-toggle{
position:fixed;
top:16px;
right:16px;
width:46px;
height:46px;
border:none;
border-radius:50%;
background:linear-gradient(135deg,#7C3AED,#A855F7);
color:#fff;
cursor:pointer;
font-size:18px;
z-index:999999;
box-shadow:0 8px 25px rgba(124,58,237,.45);
transition:.3s;
}
.theme-toggle:hover{transform:scale(1.08)}
body.light{
background:#f5f7fb !important;
color:#222;
}
body.light .card,
body.light .hero,
body.light aside{
background:#ffffff !important;
color:#222 !important;
border-color:#ddd !important;
}


#serviceOverlay{
position:fixed;
inset:0;
pointer-events:none;
z-index:2147483647;
}
#servicePanel{
position:absolute;
display:none;
width:360px;
background:rgba(17,24,39,.98);
border:1px solid #8b5cf6;
border-radius:18px;
padding:20px;
box-shadow:0 20px 50px rgba(0,0,0,.5);
backdrop-filter:blur(16px);
color:#fff;
}
#servicePanel h3{margin:0 0 10px;color:#c084fc}
#servicePanel ul{margin:0;padding-left:20px}
#servicePanel li{margin:8px 0}
body.light #servicePanel{
background:#fff;
color:#222;
border-color:#8b5cf6;
}

#loaderLogo{display:flex;gap:2px;perspective:800px}
#loaderLogo span{
display:inline-block;
animation:letterSpin 1.6s linear infinite;
}
#loaderLogo span:nth-child(1){animation-delay:0s}
#loaderLogo span:nth-child(2){animation-delay:.12s}
#loaderLogo span:nth-child(3){animation-delay:.24s}
#loaderLogo span:nth-child(4){animation-delay:.36s}
@keyframes letterSpin{
0%{transform:rotateY(0deg)}
50%{transform:rotateY(180deg);color:#c084fc}
100%{transform:rotateY(360deg)}
}


body{cursor:none;}
.cursor-dot,.cursor-ring{
position:fixed;left:0;top:0;pointer-events:none;z-index:9999999;border-radius:50%;
transform:translate(-50%,-50%);
}
.cursor-dot{width:8px;height:8px;background:#a855f7;}
.cursor-ring{width:34px;height:34px;border:2px solid rgba(168,85,247,.8);transition:width .2s,height .2s,border-color .2s;}
.cursor-ring.wave{animation:wave .6s ease-out;}
@keyframes wave{
0%{transform:translate(-50%,-50%) scale(1);opacity:1}
100%{transform:translate(-50%,-50%) scale(2);opacity:.2}
}


.ripple{
position:fixed;
width:18px;
height:18px;
border:2px solid rgba(168,85,247,.7);
border-radius:50%;
pointer-events:none;
transform:translate(-50%,-50%);
animation:rippleWave 1.2s ease-out forwards;
z-index:9999998;
}
@keyframes rippleWave{
0%{opacity:.9;transform:translate(-50%,-50%) scale(.3);}
100%{opacity:0;transform:translate(-50%,-50%) scale(4);}
}

.footer-premium{
margin-top:60px;
background:#070812;
border-top:1px solid rgba(255,255,255,.08);
padding:50px 40px 20px;
}
body.light .footer-premium{background:#eef1f8;border-top:1px solid #d8dce8;}
.footer-grid{
display:grid;
grid-template-columns:2fr 1fr 1fr 1fr;
gap:40px;
}
.footer-premium h3,.footer-premium h4{margin-bottom:15px;color:#a855f7;font-family:'Space Grotesk',sans-serif}
.footer-premium p,.footer-premium a{color:#b7bfd4;text-decoration:none;line-height:1.8}
body.light .footer-premium p,body.light .footer-premium a{color:#444}
.footer-links a{display:block}
.footer-social{display:flex;gap:14px;margin-top:10px}
.footer-social a{
width:42px;height:42px;border-radius:50%;
display:flex;align-items:center;justify-content:center;
border:1px solid rgba(168,85,247,.35);
background:rgba(255,255,255,.04);
}
.footer-copy{
margin-top:35px;
padding-top:18px;
border-top:1px solid rgba(255,255,255,.08);
text-align:center;
color:#9ca3af;
}

/* ===== Premium Neon Glass ===== */
.card,.hero,.service-box,.gallery div{
position:relative;
background:linear-gradient(180deg,rgba(43,48,61,.96),rgba(23,28,40,.96));
border:1px solid rgba(255,255,255,.08);
box-shadow:0 0 12px rgba(34,211,238,.22),0 0 18px rgba(168,85,247,.22);
overflow:hidden;
transition:.35s;
}
.card:before,.hero:before,.service-box:before{
content:"";
position:absolute;
inset:0;
padding:2px;
border-radius:24px;
background:linear-gradient(90deg,#22d3ee,#60a5fa,#a855f7,#22d3ee);
-webkit-mask:linear-gradient(#fff 0 0) content-box,linear-gradient(#fff 0 0);
-webkit-mask-composite:xor;
pointer-events:none;
}
.card:hover,.hero:hover,.service-box:hover{
transform:translateY(-5px);
box-shadow:0 0 18px rgba(34,211,238,.35),0 0 30px rgba(168,85,247,.35);
}
body.light .card,body.light .hero,body.light .service-box{
background:linear-gradient(180deg,#fff,#f4f7ff);
}


/* ===== Responsive Design ===== */
html{scroll-behavior:smooth;}
img,video,iframe{max-width:100%;height:auto;}
*{min-width:0;}

@media (max-width:1400px){
  .hero h1{font-size:3rem;}
}

@media (max-width:1200px){
  .layout{grid-template-columns:220px 1fr;}
  .grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .hero{grid-template-columns:1fr;}
  .footer-grid{grid-template-columns:repeat(2,1fr);}
}

@media (max-width:992px){
  .layout{grid-template-columns:1fr;}
  aside{
    position:relative;
    height:auto;
    width:100%;
    border-right:none;
    border-bottom:1px solid rgba(255,255,255,.08);
    padding:20px;
  }
  .logo,.menu a,p span{margin-left:0 !important;}
  .menu{
    display:grid;
    grid-template-columns:repeat(2,1fr);
    gap:10px;
  }
  .menu a{
    margin:0;
    padding:12px;
    text-align:center;
  }
  main{padding:18px;}
  .grid{grid-template-columns:1fr;}
  .hero{padding:24px;}
  .hero h1{font-size:2.4rem;}
  .avatar{font-size:6rem;}
  .social-floating{
    left:10px;
    gap:10px;
  }
}

@media (max-width:768px){
  .menu{grid-template-columns:1fr;}
  .hero h1{font-size:2rem;}
  .card{min-height:auto;}
  .gallery{grid-template-columns:repeat(2,1fr);}
  .footer-grid{grid-template-columns:1fr;}
  .social{
    width:46px;
    height:46px;
    font-size:16px;
  }
  .bot-floating,.forum-floating,.whatsapp-floating{
    width:48px;
    height:48px;
    right:12px;
  }
}

@media (max-width:480px){
  body{font-size:15px;}
  main{padding:12px;}
  .hero{padding:18px;}
  .hero h1{font-size:1.7rem;}
  .btn{
    display:block;
    width:100%;
    text-align:center;
  }
  .gallery{grid-template-columns:repeat(2,1fr);}
  .service-popup{
    width:90vw;
    left:5vw !important;
  }
}


.carousel-section{margin:28px 0 36px}
.carousel-title{font:700 2rem 'Space Grotesk';text-align:center;margin-bottom:18px}
.carousel-wrap{overflow:hidden;position:relative;padding:10px 0}
.carousel-track{display:flex;gap:18px;width:max-content;animation:scrollCards 28s linear infinite}
.carousel-card{width:180px;height:250px;border-radius:18px;overflow:hidden;position:relative;
background:linear-gradient(135deg,#2a2f42,#171b28);
border:1px solid rgba(255,255,255,.08);
box-shadow:0 0 15px rgba(168,85,247,.25);}
.carousel-card img{width:100%;height:100%;object-fit:cover;display:block;transition:.4s}
.carousel-card:hover img{transform:scale(1.08)}
.carousel-card:hover{transform:translateY(-8px) scale(1.03)}
@keyframes scrollCards{
from{transform:translateX(0)}
to{transform:translateX(-50%)}
}
@media(max-width:768px){
.carousel-card{width:140px;height:200px}
}

.stats-panel{
margin:30px 0;
padding:22px;
border-radius:24px;
background:linear-gradient(90deg,#ef5a7a,#8b5cf6,#3b82f6);
display:grid;
grid-template-columns:repeat(4,1fr);
gap:10px;
box-shadow:0 10px 30px rgba(139,92,246,.35);
}
.stat{
display:flex;
align-items:center;
gap:14px;
padding:10px 18px;
color:#fff;
}
.stat:not(:last-child){border-right:1px solid rgba(255,255,255,.2)}
.stat i{font-size:34px}
.stat h3{font-size:2rem;margin:0}
.stat p{margin:0;font-size:.95rem;opacity:.9}
@media(max-width:900px){
.stats-panel{grid-template-columns:repeat(2,1fr)}
.stat{border-right:none!important}
}
@media(max-width:600px){
.stats-panel{grid-template-columns:1fr}
}

.top-navbar{
position:sticky;
top:0;
z-index:99990;
display:flex;
justify-content:center;
align-items:center;
gap:28px;
padding:16px 24px;
margin-bottom:24px;
background:rgba(11,16,32,.72);
backdrop-filter:blur(16px);
border:1px solid rgba(168,85,247,.18);
border-radius:18px;
box-shadow:0 8px 30px rgba(0,0,0,.25);
}
.top-navbar a{
color:#fff;
text-decoration:none;
font-weight:700;
padding:10px 14px;
border-radius:10px;
transition:.3s;
}
.top-navbar a:hover{
background:linear-gradient(90deg,#8b5cf6,#3b82f6);
