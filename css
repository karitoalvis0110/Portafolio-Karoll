}
.top-navbar .talk-btn{
margin-left:auto;
background:linear-gradient(90deg,#ef5a7a,#6366f1);
padding:10px 18px;
border-radius:12px;
}
@media(max-width:992px){
.top-navbar{
overflow-x:auto;
justify-content:flex-start;
}
.top-navbar .talk-btn{margin-left:0;}
}

.contact-premium{display:grid;grid-template-columns:320px 1fr 320px;margin:50px 0;border-radius:22px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:#141826}.contact-left{background:linear-gradient(135deg,#d946ef,#4f46e5);padding:40px;color:#fff}.contact-form{padding:28px;display:grid;grid-template-columns:1fr 1fr;gap:16px}.contact-form textarea{grid-column:1/3;min-height:150px}.contact-form input,.contact-form textarea{background:#20263b;color:#fff;padding:16px;border-radius:12px;border:1px solid rgba(255,255,255,.08)}.contact-form button{grid-column:2;justify-self:end;padding:14px 24px;border:none;border-radius:12px;background:linear-gradient(90deg,#ec4899,#6366f1);color:#fff}.contact-info{padding:34px}@media(max-width:980px){.contact-premium{grid-template-columns:1fr}.contact-form{grid-template-columns:1fr}.contact-form textarea,.contact-form button{grid-column:auto}}.portfolio-btn{display:flex;justify-content:center;margin:35px 0}.btn-more{display:inline-flex;align-items:center;gap:10px;padding:16px 40px;border-radius:16px;text-decoration:none;font-size:18px;font-weight:700;color:#fff;background:linear-gradient(90deg,#8b5cf6,#3b82f6);box-shadow:0 0 20px rgba(139,92,246,.45);transition:.35s}.btn-more:hover{transform:translateY(-5px) scale(1.05);box-shadow:0 0 20px #8b5cf6,0 0 40px #3b82f6}.portfolio-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:25px;margin-top:25px;}
.portfolio-item{background:#1a2033;border-radius:18px;overflow:hidden;text-align:center;border:1px solid rgba(255,255,255,.08);transition:.35s;}
.portfolio-item:hover{transform:translateY(-8px);box-shadow:0 15px 35px rgba(139,92,246,.35);}
.portfolio-item img{display:block;width:100%;height:220px;object-fit:cover;}
.portfolio-item h4{margin:15px 0 8px;color:#fff;}
.portfolio-item p{margin-bottom:18px;color:#b7bfd4;}
